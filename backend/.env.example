# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
# Frontend origin allowed by CORS (credentials are enabled, so this must be exact)
CORS_ORIGIN=http://localhost:5173

# Postgres
DB_HOST=localhost
DB_USER=postgres
DB_PASS=change-me
DB_NAME=workflow_db

# Redis (caching degrades gracefully if unavailable)
REDIS_URL=redis://localhost:6379

# JWT signing secret: use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-me

# Required at startup by the AI decomposition feature
GEMINI_API_KEY=change-me
